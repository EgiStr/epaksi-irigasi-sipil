generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DaerahIrigasi {
  id            Int      @id @default(autoincrement())
  nama          String
  kecamatan     String
  desa          String
  luasLahan     Float
  jenisIrigasi  String
  kondisi       String
  tahunBangun   Int?
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("daerah_irigasi")
}
