// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
        

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // Hashed password for credentials login
  name          String?
  role          Role      @default(ADMIN) // Changed default to ADMIN for admin-only system
  org           String?
  status        String    @default("ACTIVE") // ACTIVE | INACTIVE
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  surveys       Survey[]
  auditLogs     AuditLog[]
  pai           PAI[]     // Relasi ke PAI
  kuesioner     Kuesioner[] // Relasi ke Kuesioner
  
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Feature {
  id          String   @id @default(cuid())
  featureId   String   @unique @map("feature_id")
  name        String?
  type        String?
  scheme      String?  // 'utama' | 'tersier' | null
  sourceLayer String   @map("source_layer")
  props       Json?
  geom        Unsupported("geometry(GEOMETRY,4326)")?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  surveys     Survey[]
  pai         PAI[]      // Relasi ke PAI
  kuesioner   Kuesioner[] // Relasi ke Kuesioner
  
  @@map("features")
  @@index([sourceLayer])
}

model Survey {
  id          String   @id @default(cuid())
  featureId   String   @map("feature_id")
  scheme      String
  tahun       Int      @default(2025) // Tahun penilaian IKSI
  values      Json     @map("values")
  scoreTotal  Float?   @map("score_total")
  scoreClass  String?  @map("score_class") // 'A' | 'B' | 'C' | 'D'
  scoreDetail Json?    @map("score_detail")
  configId    Int?     @map("config_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt
  createdBy   String   @map("created_by")
  
  feature     Feature  @relation(fields: [featureId], references: [featureId], onDelete: Cascade)
  config      Config?  @relation(fields: [configId], references: [id])
  user        User     @relation(fields: [createdBy], references: [id])
  
  @@map("surveys")
  @@unique([featureId, scheme, tahun]) // Unique constraint: 1 survey per feature+scheme+tahun
  @@index([featureId])
  @@index([scheme])
  @@index([scoreClass])
  @@index([tahun])
  @@index([createdAt])
}

model Kuesioner {
  id          String   @id @default(cuid())
  featureId   String   @map("feature_id")
  scheme      String   // 'primer' | 'sekunder' | 'tersier'
  tahun       Int      @default(2025) // Tahun penilaian kuesioner
  values      Json     @map("values") // Nilai input per field
  scoreTotal  Float?   @map("score_total") // Nilai Final (%)
  scoreClass  String?  @map("score_class") // 'BAIK' | 'SEDANG' | 'JELEK'
  scoreDetail Json?    @map("score_detail") // Detail perhitungan per kategori
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String   @map("created_by")
  
  feature     Feature  @relation(fields: [featureId], references: [featureId], onDelete: Cascade)
  user        User     @relation(fields: [createdBy], references: [id])
  
  @@map("kuesioner")
  @@unique([featureId, scheme, tahun]) // Unique constraint: 1 kuesioner per feature+scheme+tahun
  @@index([featureId])
  @@index([scheme])
  @@index([scoreClass])
  @@index([tahun])
  @@index([createdAt])
}

model Config {
  id        Int      @id @default(autoincrement())
  scheme    String
  json      Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt
  
  surveys   Survey[]
  
  @@map("configs")
  @@index([scheme])
  @@index([active])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  action      String   // 'CREATE', 'UPDATE', 'DELETE', 'LOGIN', 'LOGOUT', etc.
  entityType  String   @map("entity_type") // 'User', 'Survey', 'Feature', etc.
  entityId    String?  @map("entity_id") // ID of the affected entity
  oldValues   Json?    @map("old_values") // Previous data state
  newValues   Json?    @map("new_values") // New data state
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  details     String?  // Additional details or description
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("audit_logs")
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model PAI {
  id              String   @id @default(cuid())
  featureId       String   @map("feature_id")
  paiType         String   @map("pai_type") // 'saluran' | 'bangunan'
  tahun           Int      @default(2025) // Tahun penilaian PAI
  paiData         Json     @map("pai_data") // Structured PAI data
  photos          Json?    // Legacy field for base64 photos (deprecated)
  priorityScore   Float?   @map("priority_score") // Skor prioritas perbaikan (0-1, desimal)
  priorityNotes   String?  @map("priority_notes") @db.Text // Catatan prioritas
  priorityStatus  String?  @map("priority_status") @default("pending") // 'pending' | 'approved' | 'in_progress' | 'completed'
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String   @map("created_by")

  feature       Feature  @relation(fields: [featureId], references: [featureId], onDelete: Cascade)
  user          User     @relation(fields: [createdBy], references: [id])
  paiPhotos     Photo[]  @relation("PAIPhotos") // New relation to Photo model

  @@map("pai")
  @@unique([featureId, tahun]) // Unique constraint: 1 PAI per feature per tahun
  @@index([featureId])
  @@index([paiType])
  @@index([tahun])
  @@index([createdAt])
  @@index([priorityScore])
  @@index([priorityStatus])
}

model Photo {
  id        String   @id @default(cuid())
  paiId     String   @map("pai_id")
  url       String   // Supabase Storage public URL
  path      String   // Supabase Storage file path
  caption   String?
  metadata  Json?    // File metadata (size, type, uploadedAt, etc.)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  pai       PAI      @relation("PAIPhotos", fields: [paiId], references: [id], onDelete: Cascade)

  @@map("photos")
  @@index([paiId])
}

enum Role {
  SUPERADMIN
  ADMIN
  SURVEYOR
  VIEWER
}