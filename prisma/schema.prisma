// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // Hashed password for credentials login
  name          String?
  role          Role      @default(ADMIN) // Changed default to ADMIN for admin-only system
  org           String?
  status        String    @default("ACTIVE") // ACTIVE | INACTIVE
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]
  surveys       Survey[]
  auditLogs     AuditLog[]
  pai           PAI[]     // Relasi ke PAI
  
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Feature {
  id          String   @id @default(cuid())
  featureId   String   @unique @map("feature_id")
  name        String?
  type        String?
  scheme      String?  // 'utama' | 'tersier' | null
  sourceLayer String   @map("source_layer")
  props       Json?
  geom        Unsupported("geometry(GEOMETRY,4326)")?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  surveys     Survey[]
  pai         PAI[]    // Relasi ke PAI
  
  @@map("features")
  @@index([sourceLayer])
}

model Survey {
  id          String   @id @default(cuid())
  featureId   String   @map("feature_id")
  scheme      String
  values      Json     @map("values")
  scoreTotal  Float?   @map("score_total")
  scoreClass  String?  @map("score_class") // 'A' | 'B' | 'C' | 'D'
  scoreDetail Json?    @map("score_detail")
  configId    Int?     @map("config_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt
  createdBy   String   @map("created_by")
  
  feature     Feature  @relation(fields: [featureId], references: [featureId], onDelete: Cascade)
  config      Config?  @relation(fields: [configId], references: [id])
  user        User     @relation(fields: [createdBy], references: [id])
  
  @@map("surveys")
  @@index([featureId])
  @@index([scheme])
  @@index([scoreClass])
  @@index([createdAt])
}

model Config {
  id        Int      @id @default(autoincrement())
  scheme    String
  json      Json
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt
  
  surveys   Survey[]
  
  @@map("configs")
  @@index([scheme])
  @@index([active])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  action      String   // 'CREATE', 'UPDATE', 'DELETE', 'LOGIN', 'LOGOUT', etc.
  entityType  String   @map("entity_type") // 'User', 'Survey', 'Feature', etc.
  entityId    String?  @map("entity_id") // ID of the affected entity
  oldValues   Json?    @map("old_values") // Previous data state
  newValues   Json?    @map("new_values") // New data state
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  details     String?  // Additional details or description
  createdAt   DateTime @default(now()) @map("created_at")
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("audit_logs")
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model PAI {
  id            String   @id @default(cuid())
  featureId     String   @map("feature_id")
  paiType       String   @map("pai_type") // 'saluran' | 'bangunan'
  paiData       Json     @map("pai_data") // Structured PAI data
  photos        Json?    // Array of photo objects
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  createdBy     String   @map("created_by")

  feature       Feature  @relation(fields: [featureId], references: [featureId], onDelete: Cascade)
  user          User     @relation(fields: [createdBy], references: [id])

  @@map("pai")
  @@index([featureId])
  @@index([paiType])
  @@index([createdAt])
}

enum Role {
  SUPERADMIN
  ADMIN
  SURVEYOR
  VIEWER
}